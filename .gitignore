__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
bench/_afwork/

# scratch: run logs, probe scripts and solver workdirs from a session. These are
# not artifacts -- the artifacts are the bench/ outputs, which are checked in
# because a result that cannot be re-read is not a result.
_*.log
_*.py
_*.txt
# solver workdirs: every SBY run leaves a job/ tree of intermediate files. They are
# regenerated by the bench that produced them, and committing them would bury the
# artifacts -- bench/*.json, which are the results -- under a few hundred log files.
_ablate/
_af_*/
_af_compose/
_af_twin/
bench/_*
**/__pycache__/
